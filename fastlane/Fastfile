default_platform(:ios)

APP_ID  = "net.shadyproject.strongvibes"
SCHEME  = "StrongVibes"
PROJECT = "StrongVibes.xcodeproj"

def asc_api_key
  app_store_connect_api_key(
    key_id:       ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    issuer_id:    ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"),
    in_house:     false
  )
end

platform :ios do
  desc "Regenerate the Xcode project"
  lane :gen do
    sh("cd .. && xcodegen generate")
  end

  desc "Fetch signing assets (readonly)"
  lane :sync_signing do
    key = asc_api_key
    match(type: "development", readonly: true, api_key: key)
    match(type: "appstore",    readonly: true, api_key: key)
  end

  desc "Create/rotate signing assets (trusted machine, write token)"
  lane :bootstrap_signing do
    key = asc_api_key
    match(type: "development", readonly: false, api_key: key)
    match(type: "appstore",    readonly: false, api_key: key)
  end

  desc "Build a signed App Store archive"
  lane :build do
    gen
    sync_signing
    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" }
      }
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    build
    pilot(api_key: asc_api_key, skip_waiting_for_build_processing: true)
  end

  desc "Submit to App Store"
  lane :release do
    build
    deliver(api_key: asc_api_key, submit_for_review: false, force: true)
  end

  desc "Register a device and refresh the dev profile"
  lane :add_device do |opts|
    register_devices(devices: { opts[:name] => opts[:udid] }, api_key: asc_api_key)
    match(type: "development", readonly: false, force_for_new_devices: true, api_key: asc_api_key)
  end
end
